# 공공데이터포털 인천공항 여객 혼잡도 API 서비스 키는 더 이상 프론트엔드 .env가 아니라
# Supabase Edge Function(airport-proxy)의 Secret(AIRPORT_API_KEY)으로 관리한다.
# (`supabase secrets set AIRPORT_API_KEY=...` 또는 대시보드에서 등록 — 여기에는 두지 않음)

# Supabase 프로젝트 정보 (airport-dashboard 프로젝트)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenWeatherMap 날씨 API 키 (인천공항 날씨 표시용)
VITE_OPENWEATHER_API_KEY=
